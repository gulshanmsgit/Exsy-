rules_version = '2';
// Firestore rules for the Exsy Firebase project (exsy-591a1).
// Publish: Firebase console → Firestore Database → Rules → paste this whole file → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    // Each money book lives under an unguessable sync code (24+ characters).
    // There is no rule for listing the top level, so nobody can browse other books: you need the exact code.
    match /moneybooks/{ws}/{coll}/{docId} {
      allow read, write: if ws.size() >= 24
        && coll in ['books', 'accounts', 'txns', 'categories', 'stores', 'people', 'recurring',
                    'chits', 'chitMembers', 'chitPayments', 'chitDraws', 'prefs'];
    }
  }
}
